{
  "model": "T153 (Tina5.0)",
  "description": "T153 设备常用诊断命令全集(系统/硬件/协处理器/网络/存储/调试),已通过 adb 在 T153 / Tina5.0 / Buildroot 2022.05 (内核 5.10.198-rt97, armv7l) 逐条实测验证",
  "codec": "UTF-8",
  "commands": [
    {"name": "【系统】内核/主机/运行时间", "cmd": "uname -a; hostname; uptime"},
    {"name": "【系统】系统版本", "cmd": "cat /etc/os-release 2>/dev/null; cat /proc/version"},
    {"name": "【系统】内核启动参数", "cmd": "cat /proc/cmdline"},
    {"name": "【系统】系统负载", "cmd": "cat /proc/loadavg"},
    {"name": "【系统】运行时间(秒)", "cmd": "cat /proc/uptime"},
    {"name": "【系统】环境变量", "cmd": "env"},
    {"name": "【系统】系统日志 syslog", "cmd": "tail -n 100 /tmp/messages 2>/dev/null"},
    {"name": "【系统】近期内核日志", "cmd": "dmesg | tail -n 80"},
    {"name": "【系统】内核编译配置", "cmd": "zcat /proc/config.gz 2>/dev/null | head -40"},
    {"name": "【系统】内核硬件枚举日志", "cmd": "dmesg | grep -iE 'ethernet|usb|mmc|nand|wifi|bluetooth|rtc|watchdog|i2c|spi' | head -30"},
    {"name": "【系统】芯片信息 sunxi_info", "cmd": "cat /sys/class/sunxi_info/sys_info"},
    {"name": "【系统】进程数量统计", "cmd": "ls /proc/ | grep -cE '^[0-9]+$'"},
    {"name": "【系统】init 进程状态", "cmd": "cat /proc/1/status"},
    {"name": "【系统】sysctl 系统参数", "cmd": "sysctl kernel.hostname kernel.osrelease"},
    {"name": "【系统】中断统计", "cmd": "cat /proc/interrupts"},
    {"name": "【系统】内存页统计 buddyinfo", "cmd": "cat /proc/buddyinfo"},
    {"name": "【系统】内核内存统计 vmstat", "cmd": "cat /proc/vmstat | head -20"},
    {"name": "【系统】启动配置 inittab", "cmd": "cat /etc/inittab"},
    {"name": "【系统】用户/组账号", "cmd": "cat /etc/passwd; cat /etc/group"},
    {"name": "【系统】主机名/DNS 配置", "cmd": "cat /etc/hostname; cat /etc/hosts; cat /etc/resolv.conf"},
    {"name": "【系统】测试/工具脚本清单", "cmd": "ls -l /etc/*.sh"},
    {"name": "【系统】内核 sysctl 关键参数", "cmd": "cat /proc/sys/kernel/panic /proc/sys/kernel/printk /proc/sys/vm/swappiness /proc/sys/kernel/pid_max /proc/sys/fs/file-max /proc/sys/net/core/somaxconn"},
    {"name": "【系统】文件描述符限制", "cmd": "ulimit -n"},
    {"name": "【系统】根目录结构", "cmd": "ls -la /"},
    {"name": "【系统】系统电源状态", "cmd": "cat /sys/power/state"},
    {"name": "【系统】固件清单", "cmd": "ls -l /lib/firmware/"},
    {"name": "【系统】网络服务端口表", "cmd": "cat /etc/services"},
    {"name": "【系统】启动脚本 rcS", "cmd": "cat /etc/init.d/rcS"},
    {"name": "【系统】板级信息", "cmd": "cat /proc/device-tree/compatible; echo; cat /proc/device-tree/board; echo; cat /proc/device-tree/serial-number"},
    {"name": "【CPU/内存】CPU 信息", "cmd": "cat /proc/cpuinfo"},
    {"name": "【CPU/内存】内存信息", "cmd": "cat /proc/meminfo"},
    {"name": "【CPU/内存】内存使用 free", "cmd": "free"},
    {"name": "【CPU/内存】进程快照", "cmd": "ps 2>/dev/null || ps -ef 2>/dev/null || ps aux 2>/dev/null"},
    {"name": "【CPU/内存】进程 TOP", "cmd": "top -b -n 1"},
    {"name": "【CPU/内存】CPU 统计 iostat", "cmd": "iostat"},
    {"name": "【CPU/内存】各核占用 mpstat", "cmd": "mpstat"},
    {"name": "【CPU/内存】打开文件 lsof", "cmd": "lsof"},
    {"name": "【CPU/内存】CPU 核数", "cmd": "nproc"},
    {"name": "【硬件】芯片型号", "cmd": "cat /proc/device-tree/model 2>/dev/null"},
    {"name": "【硬件】CPU/DDR 温度", "cmd": "for z in /sys/class/thermal/thermal_zone*; do echo \"$(cat $z/type): $(cat $z/temp)\"; done"},
    {"name": "【硬件】看门狗设备", "cmd": "ls -l /dev/watchdog* 2>/dev/null"},
    {"name": "【硬件】设备节点清单", "cmd": "ls /dev/"},
    {"name": "【硬件】寄存器读 sunxi_dump", "cmd": "echo 0x03000000 > /sys/class/sunxi_dump/dump; cat /sys/class/sunxi_dump/dump"},
    {"name": "【硬件】SPI 总线设备", "cmd": "ls /sys/bus/spi/devices/"},
    {"name": "【硬件】PWM 控制器", "cmd": "ls /sys/class/pwm/"},
    {"name": "【硬件】背光设备", "cmd": "ls /sys/class/backlight/"},
    {"name": "【硬件】输入设备", "cmd": "ls /sys/class/input/"},
    {"name": "【硬件】DRM 显示设备", "cmd": "ls /sys/class/drm/"},
    {"name": "【硬件】电源调节器", "cmd": "ls /sys/class/regulator/"},
    {"name": "【硬件】热区接口", "cmd": "ls /sys/class/thermal/"},
    {"name": "【硬件】无线状态 iw", "cmd": "iw dev"},
    {"name": "【硬件】RTC 时钟 hwclock", "cmd": "hwclock"},
    {"name": "【硬件】SWUpdate 工具版本", "cmd": "swupdate -h 2>&1 | head -2"},
    {"name": "【硬件】fw_printenv 环境配置", "cmd": "cat /etc/fw_env.config"},
    {"name": "【硬件】TEE 安全设备", "cmd": "ls -l /dev/tee*"},
    {"name": "【硬件】协处理器 AMP 状态", "cmd": "cat /proc/device-tree/sunxi-amp/status"},
    {"name": "【硬件】USB gadget/UDC", "cmd": "ls /sys/class/udc/; ls /dev/usb-ffs/"},
    {"name": "【硬件】帧缓冲属性 fb0", "cmd": "cat /sys/class/graphics/fb0/mode /sys/class/graphics/fb0/name /sys/class/graphics/fb0/virtual_size /sys/class/graphics/fb0/bits_per_pixel"},
    {"name": "【硬件】无线固件 AIC8800", "cmd": "ls -l /lib/firmware/ | grep -i aic"},
    {"name": "【硬件】RISC-V 协处理器固件", "cmd": "ls -l /lib/firmware/ | grep -iE 'amp|rv'"},
    {"name": "【硬件】设备树 SoC 外设地址表", "cmd": "ls /proc/device-tree/soc@3000000/"},
    {"name": "【硬件】寄存器批量读取 sunxi_dump", "cmd": "for a in 0x02600000 0x02002000 0x02050000 0x03604000 0x02510000 0x03006000; do echo -n \"$a = \"; echo $a > /sys/class/sunxi_dump/dump; cat /sys/class/sunxi_dump/dump; done"},
    {"name": "【硬件】关键外设寄存器读取", "cmd": "for a in 0x02050000 0x02600000 0x0260000c 0x02600014 0x03604000 0x03604010; do echo -n \"$a = \"; echo $a > /sys/class/sunxi_dump/dump; cat /sys/class/sunxi_dump/dump; done"},
    {"name": "【硬件】外设使能状态查询", "cmd": "for n in e907_rproc@1a00000 ethernet@4520000 amp_ts@8120000; do echo -n \"$n = \"; cat /proc/device-tree/soc@3000000/$n/status 2>/dev/null; echo; done"},
    {"name": "【I2C】i2c 总线扫描", "cmd": "i2cdetect -l"},
    {"name": "【网络】网卡 ip", "cmd": "ip a 2>/dev/null || ifconfig -a"},
    {"name": "【网络】网卡 ifconfig", "cmd": "ifconfig -a 2>/dev/null"},
    {"name": "【网络】路由", "cmd": "ip route 2>/dev/null || route -n 2>/dev/null"},
    {"name": "【网络】路由表 route", "cmd": "route -n 2>/dev/null"},
    {"name": "【网络】网络接口统计", "cmd": "cat /proc/net/dev"},
    {"name": "【网络】网络连接 netstat", "cmd": "netstat -an 2>/dev/null"},
    {"name": "【网络】套接字 ss", "cmd": "ss -t 2>/dev/null"},
    {"name": "【网络】ARP 表", "cmd": "cat /proc/net/arp 2>/dev/null; arp -a 2>/dev/null"},
    {"name": "【网络】网卡详情 ethtool", "cmd": "ethtool eth0"},
    {"name": "【网络】抓包 tcpdump", "cmd": "tcpdump -i eth0 -n -c 10"},
    {"name": "【网络】带宽测试 iperf3", "cmd": "iperf3 -c 192.168.1.100 -t 5"},
    {"name": "【网络】网络转发参数", "cmd": "cat /proc/sys/net/ipv4/ip_forward"},
    {"name": "【网络】lo 环回连通测试", "cmd": "ifconfig lo up; ping -c 3 127.0.0.1"},
    {"name": "【网络】网卡链路状态", "cmd": "cat /sys/class/net/eth0/operstate /sys/class/net/eth0/carrier /sys/class/net/eth0/speed /sys/class/net/eth0/address 2>/dev/null"},
    {"name": "【网络】无线 AP 配置", "cmd": "head -10 /etc/hostapd.conf"},
    {"name": "【网络】无线 STA 配置", "cmd": "grep -vE 'psk|ssid|password' /etc/wpa_supplicant.conf"},
    {"name": "【网络】PTP 时间同步配置", "cmd": "cat /etc/linuxptp.cfg"},
    {"name": "【存储】磁盘挂载/使用", "cmd": "df -h; mount"},
    {"name": "【存储】NAND 分区 mtd", "cmd": "cat /proc/mtd"},
    {"name": "【存储】块分区", "cmd": "cat /proc/partitions"},
    {"name": "【存储】UBI 信息", "cmd": "ubinfo -a 2>/dev/null"},
    {"name": "【存储】分区映射 by-name", "cmd": "ls -l /dev/by-name/ 2>/dev/null"},
    {"name": "【存储】块设备 UUID blkid", "cmd": "blkid 2>/dev/null"},
    {"name": "【存储】MTD 分区详情 mtd_debug", "cmd": "mtd_debug info /dev/mtd0"},
    {"name": "【存储】NAND 读取 nanddump", "cmd": "nanddump -l 0x100 /dev/mtd4"},
    {"name": "【存储】NAND 头部读取 dd", "cmd": "dd if=/dev/mtd0 bs=2048 count=1 2>/dev/null | hexdump -C"},
    {"name": "【存储】磁盘占用 du", "cmd": "du -sh /etc /tmp /var /mnt/UDISK 2>/dev/null"},
    {"name": "【存储】UDISK 数据分区内容", "cmd": "ls -l /mnt/UDISK/"},
    {"name": "【存储】NAND/UBI 工具清单", "cmd": "ls /usr/sbin/ | grep -E '^(flash|nand|ubi)'"},
    {"name": "【存储】块设备列表 block", "cmd": "ls /sys/class/block/"},
    {"name": "【存储】NFS 挂载服务器", "cmd": "cat /proc/fs/nfsfs/servers"},
    {"name": "【存储】boot0 eGON 引导头", "cmd": "dd if=/dev/mtd0 bs=2048 count=1 2>/dev/null | hexdump -C"},
    {"name": "【存储】uboot 头部", "cmd": "dd if=/dev/mtd1 bs=2048 count=1 2>/dev/null | hexdump -C"},
    {"name": "【存储】boot 参数分区", "cmd": "dd if=/dev/mtd3 bs=2048 count=1 2>/dev/null | hexdump -C"},
    {"name": "【存储】uboot 版本/组件字符串", "cmd": "dd if=/dev/mtd1 bs=2048 count=8 2>/dev/null | strings | head -20"},
    {"name": "【存储】uboot 环境变量", "cmd": "dd if=/dev/ubi0_2 bs=2048 count=4 2>/dev/null | strings | head -40"},
    {"name": "【音频】声卡信息", "cmd": "cat /proc/asound/cards"},
    {"name": "【音频】混音器控制 amixer", "cmd": "amixer scontrols"},
    {"name": "【显示】帧缓冲信息 fbset", "cmd": "fbset"},
    {"name": "【校验】文件校验 md5sum", "cmd": "md5sum /etc/hostname"},
    {"name": "【校验】文件校验 sha256sum", "cmd": "sha256sum /etc/hostname"},
    {"name": "【校验】文件校验 cksum", "cmd": "cksum /etc/hostname"},
    {"name": "【校验】文件校验 crc32", "cmd": "crc32 /etc/hostname"},
    {"name": "【校验】打包/解包 tar", "cmd": "tar -cf /tmp/backup.tar /etc; tar -tf /tmp/backup.tar; rm -f /tmp/backup.tar"},
    {"name": "【校验】压缩 gzip", "cmd": "gzip -c /etc/hostname"},
    {"name": "【调试】hexdump 查看文件", "cmd": "hexdump -C /proc/cpuinfo | head -20"},
    {"name": "【调试】od 查看文件", "cmd": "od -c /proc/cpuinfo | head -10"},
    {"name": "【调试】xxd 查看文件", "cmd": "xxd /proc/cpuinfo | head -10"},
    {"name": "【调试】字符串提取 strings", "cmd": "strings /bin/busybox | head -20"},
    {"name": "【调试】写系统日志 logger", "cmd": "logger \"adb debug log\"; tail -3 /tmp/messages"},
    {"name": "【串口】串口终端 microcom", "cmd": "microcom -s 115200 /dev/ttyAS0"},
    {"name": "【进程/服务】启动服务脚本", "cmd": "ls /etc/init.d/ 2>/dev/null"},
    {"name": "【时间】当前时间", "cmd": "date"}
  ]
}
