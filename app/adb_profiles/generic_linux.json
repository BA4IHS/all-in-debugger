{
  "model": "通用 Linux",
  "description": "适用于通过 adb 提供 /bin/sh 的嵌入式 Linux 设备",
  "codec": "UTF-8",
  "commands": [
    {"name": "内核/主机/运行时间", "cmd": "uname -a; hostname; uptime"},
    {"name": "CPU 信息", "cmd": "cat /proc/cpuinfo"},
    {"name": "内存信息", "cmd": "cat /proc/meminfo"},
    {"name": "系统版本", "cmd": "cat /etc/os-release 2>/dev/null; cat /proc/version"},
    {"name": "网卡", "cmd": "ip a 2>/dev/null || ifconfig -a"},
    {"name": "路由", "cmd": "ip route 2>/dev/null || route -n 2>/dev/null"},
    {"name": "磁盘挂载/使用", "cmd": "df -h; mount"},
    {"name": "环境变量", "cmd": "env"},
    {"name": "近期内核日志", "cmd": "dmesg | tail -n 80"},
    {"name": "已加载模块", "cmd": "lsmod"},
    {"name": "进程快照", "cmd": "ps 2>/dev/null || ps -ef 2>/dev/null || ps aux 2>/dev/null"}
  ]
}
